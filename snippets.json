        "    const cache = {};",
        "",
        "    return (...args) => {",
        "        const key = JSON.stringify(args);",
        "",
        "        if (key in cache) {",
        "            return cache[key];",
        "        }",
        "",
        "        cache[key] = fn(...args);",
        "        return cache[key];",
        "    };",
        "};",
        "",
        "const square = memoize((n) => n * n);",
        "console.log(square(9), square(9));"
      ]
